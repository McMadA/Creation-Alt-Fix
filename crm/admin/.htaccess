# Disable Directory Browsing
Options -Indexes

# Privacy: Prevent Search Indexing of Admin Area
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# ----------------------------------------------------------------------
# Security & Access Control for Admin Dashboard
# ----------------------------------------------------------------------
# Uncomment and replace <YOUR_TAILSCALE_OR_STATIC_IP> with your Tailscale exit node or trusted public IP address
# to restrict access to this directory.
#
# <IfModule mod_authz_core.c>
#     Require ip <YOUR_TAILSCALE_OR_STATIC_IP>
# </IfModule>

