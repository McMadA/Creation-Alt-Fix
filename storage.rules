rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // Helper: Check if the authenticated user is an admin
    // Mirrored from firestore.rules for consistency
    // ============================================================
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['allardv03@gmail.com', 'info@creationaltfix.nl']
        && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com')
      );
    }

    // ============================================================
    // Helper: Check if authenticated user owns the project
    // Performs cross-service lookup in Cloud Firestore
    // ============================================================
    function isProjectOwner(projectId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/projects/$(projectId)) && (
          (firestore.get(/databases/(default)/documents/projects/$(projectId)).data.clientUid != null &&
           firestore.get(/databases/(default)/documents/projects/$(projectId)).data.clientUid == request.auth.uid) ||
          (firestore.get(/databases/(default)/documents/projects/$(projectId)).data.email != null &&
           request.auth.token.email != null &&
           firestore.get(/databases/(default)/documents/projects/$(projectId)).data.email == request.auth.token.email
           && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'))
        );
    }

    // ============================================================
    // Project Files (client uploads: logo's, teksten, afbeeldingen)
    // Path: projects/{projectId}/{fileName}
    // 
    // - Only admins or verified project owner can READ files
    // - Only admins or verified project owner can UPLOAD files
    //   (max 10 MB per file, safe non-executable MIME types)
    // ============================================================
    match /projects/{projectId}/{allPaths=**} {
      allow read: if isAdmin() || isProjectOwner(projectId);

      allow create, update: if isAdmin()
                   || (isProjectOwner(projectId)
                       && request.resource.size > 0
                       && request.resource.size < 10 * 1024 * 1024
                       && request.resource.contentType.matches('image/(jpeg|png|webp|gif)|application/pdf|text/plain|application/msword|application/vnd.openxmlformats-officedocument.*')
                       && !allPaths.matches('.*\\.\\..*')
                       && allPaths.matches('(?i).*\\.(jpg|jpeg|png|webp|gif|pdf|txt|doc|docx|xls|xlsx|csv)$')
                       && !allPaths.matches('(?i).*\\.(php|phtml|phar|html|htm|js|jsx|ts|tsx|exe|dll|sh|bat|cmd|vbs|jar|svg|asp|aspx|py|pl|cgi|ps1|com|scr|msi|hta|cpl|wsf|jsp|jspx|xhtml|shtml|env|config|htaccess|ini)$'));

      allow delete: if isAdmin() || isProjectOwner(projectId);
    }

    // ============================================================
    // Proposal & Invoice PDFs (generated by system / admin)
    // Path: proposals/{projectId}/{fileName}
    // Path: invoices/{projectId}/{fileName}
    //
    // - Only admins can write/generate/overwrite PDFs (enforce max 20MB, application/pdf and .pdf extension)
    // - Authenticated project owners and admins can download
    // ============================================================
    match /proposals/{projectId}/{allPaths=**} {
      allow read: if isAdmin() || isProjectOwner(projectId);
      allow write: if isAdmin()
                   && request.resource.size > 0
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf'
                   && allPaths.matches('(?i).*\\.pdf$');
    }

    match /invoices/{projectId}/{allPaths=**} {
      allow read: if isAdmin() || isProjectOwner(projectId);
      allow write: if isAdmin()
                   && request.resource.size > 0
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf'
                   && allPaths.matches('(?i).*\\.pdf$');
    }

    // ============================================================
    // Default: deny all other paths
    // ============================================================
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
