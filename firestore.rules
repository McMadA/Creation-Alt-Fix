rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper: Check if the authenticated user is an admin
    // Authenticated via admin email whitelist OR exists in 'admins' collection
    // ============================================================
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email in ['allardv03@gmail.com', 'info@creationaltfix.nl']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ============================================================
    // Admins Collection
    // Only readable by authenticated users (for login check)
    // Only writable via Firebase Console (manual provisioning)
    // ============================================================
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ============================================================
    // Projects Collection
    // Core CRM data - tiered access control
    // ============================================================
    match /projects/{projectId} {

      // CREATE: Anyone can create a new project (public intake form)
      allow create: if true;

      // GET (single document): 
      //   - Admins can read any project
      //   - Authenticated clients can read their OWN project (matched by clientUid or authenticated email)
      allow get: if isAdmin()
                 || (request.auth != null && (
                      resource.data.clientUid == request.auth.uid
                      || resource.data.email == request.auth.token.email
                    ));

      // LIST (query all documents):
      //   - Only admins can list/query all projects
      //   - Clients can list projects where their email or UID matches
      allow list: if isAdmin()
                  || (request.auth != null && (
                       resource.data.clientUid == request.auth.uid
                       || resource.data.email == request.auth.token.email
                     ));

      // UPDATE:
      //   - Admins can update any field
      //   - Authenticated clients can only update specific status fields (digital signature, proposal PDF, design accept, files, messages, tickets, annotations)
      allow update: if isAdmin()
                    || (request.auth != null 
                        && (resource.data.clientUid == request.auth.uid || resource.data.email == request.auth.token.email)
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'statusClass', 'proposalAcceptedAt', 'proposalSignedBy', 'proposalPdfUrl', 'proposalPdfName', 'designAcceptedAt', 'files', 'messages', 'tickets', 'annotations']));

      // DELETE: Only admins
      allow delete: if isAdmin();
    }
  }
}
