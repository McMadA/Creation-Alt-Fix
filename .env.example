# =============================================================
# Creation+Alt+Fix - Lead Factory Omgevingsvariabelen
# Kopieer dit bestand naar '.env' en vul de waarden in.
# Het .env bestand staat in .gitignore en wordt NOOIT gecommit!
# =============================================================

# --- VIMEXX FTPS Credentials ---
# Vul je FTP-inloggegevens in zodat de factory direct naar Vimexx kan uploaden.
# Je vindt deze in je Vimexx DirectAdmin onder FTP-beheer.
FTP_SERVER=web0156.zxcs.nl
FTP_PORT=21
FTP_USERNAME=je_ftp_gebruikersnaam_hier
FTP_PASSWORD=je_ftp_wachtwoord_hier

# Zet op 'false' als het SSL-certificaat van de FTP server niet geldig is (zelden nodig)
FTP_REJECT_UNAUTHORIZED=true

# --- Vimexx SMTP (optioneel - voor directe e-mailverzending) ---
SMTP_HOST=mail.zxcs.nl
SMTP_PORT=465
SMTP_USER=info@creationaltfix.nl
SMTP_PASSWORD=je_smtp_wachtwoord_hier

# --- Bridge Auth Token (wordt automatisch gegenereerd, hoef je niet in te vullen) ---
# CAF_BRIDGE_TOKEN=
