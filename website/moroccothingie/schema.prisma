// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum EntityType {
  INDIVIDUAL
  COMPANY
}

enum DocumentType {
  DEVIS          // Quote
  COMMANDE       // Purchase/Sales Order
  LIVRAISON      // Delivery Note (BL)
  FACTURE        // Invoice
  RECU           // Receipt
}

enum DocumentStatus {
  DRAFT
  VALIDATED
  PARTIAL
  FULFILLED
  INVOICED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CHECK
  TRANSFER
  DRAFT          // Effet/Lettre de Change
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

// ------------------------------------------------------
// A. Business Profile & Multi-Tenancy
// ------------------------------------------------------

model Business {
  id           String   @id @default(uuid())
  name         String
  address      String?
  city         String?
  ice          String?  @db.VarChar(15) // Identifiant Commun de l'Entreprise
  if           String?  // Identifiant Fiscal
  rc           String?  // Registre du Commerce
  cnss         String?
  phone        String?
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  users        User[]
  clients      Entity[] @relation("BusinessClients")
  products     Product[]
  documents    Document[]
  sessions     CashSession[]
  warehouses   Warehouse[]
}

model User {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  email        String   @unique
  name         String
  role         Role     @default(CASHIER)
  createdAt    DateTime @default(now())
  
  cashSessions CashSession[]
  auditLogs    AuditLog[]
}

// ------------------------------------------------------
// B. Client & Supplier Management (Tier / Tiers)
// ------------------------------------------------------

model Entity {
  id           String     @id @default(uuid())
  businessId   String
  business     Business   @relation("BusinessClients", fields: [businessId], references: [id])
  isSupplier   Boolean    @default(false)
  isClient     Boolean    @default(true)
  type         EntityType @default(COMPANY)
  name         String
  phone        String?
  email        String?
  address      String?
  city         String?
  ice          String?    @db.VarChar(15)
  if           String?
  balance      Decimal    @default(0) @db.Decimal(12, 2) // Outstanding debt / credit
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  documents    Document[]
}

// ------------------------------------------------------
// C. Product & Inventory Management (Stock)
// ------------------------------------------------------

model Product {
  id                  String   @id @default(uuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id])
  name                String
  sku                 String?
  barcode             String?  @unique
  unit                String   // e.g., Pcs, Kg, Meter, Box
  costPrice           Decimal  @db.Decimal(12, 2) // Prix d'achat
  retailPrice         Decimal  @db.Decimal(12, 2) // Prix de vente
  tvaRate             Decimal  @db.Decimal(5, 2)  // 20, 14, 10, 7, 0
  reorderAlertLevel   Int      @default(0) // Seuil de réapprovisionnement
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  stockMovements      StockMovement[]
  documentLines       DocumentLine[]
  warehouseStocks     WarehouseStock[]
}

model Warehouse {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  name         String   // e.g. Dépôt Principal
  location     String?
  
  stocks       WarehouseStock[]
  movements    StockMovement[]
}

model WarehouseStock {
  id           String   @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  quantity     Int       @default(0) 
  // NOTE: A PostgreSQL Check Constraint should be added via raw SQL migration:
  // ALTER TABLE "WarehouseStock" ADD CONSTRAINT "chk_qty_not_negative" CHECK (quantity >= 0);
  
  @@unique([warehouseId, productId])
}

model StockMovement {
  id           String            @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  type         StockMovementType
  quantity     Int
  reference    String?           // E.g., BL number or manual adjustment reason
  createdAt    DateTime          @default(now())
}

// ------------------------------------------------------
// D. Billing Workflow & Documents (Devis, BL, Facture)
// ------------------------------------------------------

model Document {
  id               String         @id @default(uuid())
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id])
  type             DocumentType
  code             String         // e.g. DEV-2026-0001
  issueDate        DateTime       @default(now())
  dueDate          DateTime?
  
  clientId         String
  client           Entity         @relation(fields: [clientId], references: [id])
  
  status           DocumentStatus @default(DRAFT)
  
  totalHT          Decimal        @default(0) @db.Decimal(12, 2)
  totalTVA         Decimal        @default(0) @db.Decimal(12, 2)
  totalTTC         Decimal        @default(0) @db.Decimal(12, 2)
  discount         Decimal        @default(0) @db.Decimal(12, 2)
  
  // Document conversion lineage
  parentDocumentId String?
  parentDocument   Document?      @relation("DocumentLineage", fields: [parentDocumentId], references: [id])
  childDocuments   Document[]     @relation("DocumentLineage")
  
  lines            DocumentLine[]
  payments         Payment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  @@unique([businessId, type, code])
}

model DocumentLine {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  
  description  String
  quantity     Int
  // Price Snapshotting: Critical for audit and billing integrity
  unitPriceHT  Decimal  @db.Decimal(12, 2) // Snapshotted price at creation
  tvaRate      Decimal  @db.Decimal(5, 2)  // Snapshotted TVA
  
  totalHT      Decimal  @db.Decimal(12, 2)
  totalTTC     Decimal  @db.Decimal(12, 2)
}

// ------------------------------------------------------
// E & F. POS, Payments & Account Receivables
// ------------------------------------------------------

model CashSession {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  managerId       String
  manager         User      @relation(fields: [managerId], references: [id])
  
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  openingBalance  Decimal   @db.Decimal(12, 2)
  expectedBalance Decimal?  @db.Decimal(12, 2)
  actualBalance   Decimal?  @db.Decimal(12, 2)
}

model Payment {
  id              String        @id @default(uuid())
  documentId      String
  document        Document      @relation(fields: [documentId], references: [id])
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  transactionRef  String?       // Check number, transfer ref
  date            DateTime      @default(now())
  createdAt       DateTime      @default(now())
}

// ------------------------------------------------------
// G. Audit Logs
// ------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // e.g. "DOCUMENT_CANCELLED", "STOCK_ADJUSTED"
  entityId  String   // ID of affected record
  details   Json     // Before/After states
  createdAt DateTime @default(now())
}
