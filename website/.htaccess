# Creation+Alt+Fix Production Configuration
Options -Indexes

# ============ SECURITY & SENSITIVE FILES BLOCK ============
<FilesMatch "\.(clixml|db|sqlite|env|json|sql|yml|yaml|md|log|ps1|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ============ SECURITY & EU TDM AI SHIELD HEADERS ============
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noai, noimageai"
    Header set TDM-Reservation "1"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ============ 1. FORCE HTTPS ============
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{SERVER_PORT} 80
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ============ 2. SUBDOMEIN CANONICAL ROUTING ============
    # Stroomlijn legacy /portal/* paden op hoofddomein naar het officiële subdomein portal.creationaltfix.nl
    RewriteCond %{HTTP_HOST} ^(www\.)?creationaltfix\.nl$ [NC]
    RewriteRule ^portal(?:/(.*))?$ https://portal.creationaltfix.nl/$1 [R=301,L]

    # Stroomlijn hbi.creationaltfix.nl -> https://creationaltfix.nl/projects/home-buyer-intelligence/
    RewriteCond %{HTTP_HOST} ^hbi\.creationaltfix\.nl$ [NC]
    RewriteRule ^(?:projects/home-buyer-intelligence/)?(.*)$ https://creationaltfix.nl/projects/home-buyer-intelligence/$1 [R=301,L]
</IfModule>

# Custom 404 Error Page
ErrorDocument 404 /404.html

# Enable Compression
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
    </IfModule>
</IfModule>

# Browser Caching Headers
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>