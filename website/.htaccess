# Creation+Alt+Fix Production Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ============ SUBDOMEIN CANONICAL ROUTING (TASK-818) ============
    # 1. Stroomlijn portal.creationaltfix.nl -> https://creationaltfix.nl/portal/
    RewriteCond %{HTTP_HOST} ^portal\.creationaltfix\.nl$ [NC]
    RewriteRule ^(.*)$ https://creationaltfix.nl/portal/$1 [R=301,L]

    # 2. Stroomlijn hbi.creationaltfix.nl -> https://creationaltfix.nl/projects/home-buyer-intelligence/
    RewriteCond %{HTTP_HOST} ^hbi\.creationaltfix\.nl$ [NC]
    RewriteRule ^(.*)$ https://creationaltfix.nl/projects/home-buyer-intelligence/$1 [R=301,L]
</IfModule>

# Custom 404 Error Page
ErrorDocument 404 /404.html

# Enable Compression
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
    </IfModule>
</IfModule>

# Browser Caching Headers
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>