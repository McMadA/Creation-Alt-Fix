# Creation+Alt+Fix Production Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ============ 1. FORCE HTTPS ============
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ============ 2. SUBDOMEIN CANONICAL ROUTING ============
    # Stroomlijn legacy /portal/* paden op hoofddomein naar het officiële subdomein portal.creationaltfix.nl
    RewriteCond %{HTTP_HOST} ^(www\.)?creationaltfix\.nl$ [NC]
    RewriteRule ^portal(?:/(.*))?$ https://portal.creationaltfix.nl/$1 [R=301,L]

    # Stroomlijn hbi.creationaltfix.nl -> https://creationaltfix.nl/projects/home-buyer-intelligence/
    RewriteCond %{HTTP_HOST} ^hbi\.creationaltfix\.nl$ [NC]
    RewriteRule ^(?:projects/home-buyer-intelligence/)?(.*)$ https://creationaltfix.nl/projects/home-buyer-intelligence/$1 [R=301,L]
</IfModule>

# Custom 404 Error Page
ErrorDocument 404 /404.html

# Enable Compression
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
    </IfModule>
</IfModule>

# Browser Caching Headers
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>